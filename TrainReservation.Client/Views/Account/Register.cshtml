@model Shared.Requests.RegisterRequest

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Enterprise Train Reservation</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                margin: 0;
                min-height: 100vh;
                background: linear-gradient(135deg,#0F4C81,#2563EB,#3B82F6);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: "Segoe UI",sans-serif;
                padding: 40px;
            }

            .register-card {
                width: 1100px;
                border-radius: 25px;
                overflow: hidden;
                background: white;
                box-shadow: 0 30px 60px rgba(0,0,0,.25);
            }

            .left-panel {
                background: linear-gradient(160deg,#0F4C81,#1E40AF);
                color: white;
                padding: 60px;
                height: 100%;
            }

                .left-panel h2 {
                    margin-top: 25px;
                    font-weight: bold;
                }

                .left-panel p {
                    margin-top: 20px;
                    font-size: 18px;
                    opacity: .9;
                }

            .feature {
                margin-top: 35px;
            }

                .feature p {
                    margin-bottom: 18px;
                }

                .feature i {
                    color: #FFD54F;
                    margin-right: 10px;
                }

            .train-icon {
                font-size: 80px;
            }

            .right-panel {
                padding: 50px;
            }

            .title {
                color: #0F4C81;
                font-weight: bold;
            }

            .subtitle {
                color: gray;
                margin-bottom: 30px;
            }

            .form-control {
                height: 50px;
                border-radius: 10px;
            }

            .btn-register {
                height: 52px;
                border: none;
                border-radius: 10px;
                background: #16A34A;
                font-weight: bold;
                font-size: 17px;
            }

                .btn-register:hover {
                    background: #15803D;
                }

            .login-link {
                text-decoration: none;
                font-weight: 600;
            }

            label {
                font-weight: 600;
                color: #555;
                margin-bottom: 6px;
            }

    </style>

</head>

<body>

    <div class="register-card">

        <div class="row g-0">

            <div class="col-lg-5 left-panel">

                <div class="train-icon">

                    <i class="bi bi-person-plus-fill"></i>

                </div>

                <h2>

                    Create Your Account

                </h2>

                <p>

                    Register to reserve train tickets, manage your bookings and receive smart travel predictions.

                </p>

                <div class="feature">

                    <p><i class="bi bi-check-circle-fill"></i>Online Ticket Booking</p>

                    <p><i class="bi bi-check-circle-fill"></i>Seat Availability Prediction</p>

                    <p><i class="bi bi-check-circle-fill"></i>Weekly Booking Reports</p>

                    <p><i class="bi bi-check-circle-fill"></i>Fast & Secure Reservation</p>

                </div>

            </div>

            <div class="col-lg-7 right-panel">

                <h2 class="title">

                    User Registration

                </h2>

                <p class="subtitle">

                    Complete the information below to create your account.

                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">

                        @ViewBag.Error

                    </div>
                }

                <form asp-action="Register"
                      method="post">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label>NIC</label>

                            <input asp-for="Nic"
                                   class="form-control"
                                   placeholder="National Identity Card" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label>Mobile Number</label>

                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   placeholder="07XXXXXXXX" />

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label>First Name</label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="First Name" />

                        </div>

                        <div class="col-md-6 mb-3">

                            <label>Last Name</label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Last Name" />

                        </div>

                    </div>

                    <div class="mb-3">

                        <label>Email Address</label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="example@email.com" />

                    </div>

                    <div class="mb-4">

                        <label>Password</label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Create a Password" />

                    </div>

                    <button type="submit"
                            class="btn btn-success btn-register w-100">

                        <i class="bi bi-person-check-fill me-2"></i>

                        Create Account

                    </button>

                </form>

                <hr class="my-4" />

                <div class="text-center">

                    Already have an account?

                    <a asp-action="Login"
                       class="login-link">

                        Sign In

                    </a>

                </div>

            </div>

        </div>

    </div>

</body>

</html>