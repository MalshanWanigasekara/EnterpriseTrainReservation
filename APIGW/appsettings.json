{
  "ReverseProxy": {
    "Routes": {
      "userRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users"
          }
        ]
      },

      "bookingRoute": {
        "ClusterId": "bookingCluster",
        "Match": {
          "Path": "/bookings/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/bookings"
          }
        ]
      },

      "predictionRoute": {
        "ClusterId": "predictionCluster",
        "Match": {
          "Path": "/predictions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/predictions"
          }
        ]
      },

      "reportRoute": {
        "ClusterId": "reportCluster",
        "Match": {
          "Path": "/reports/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/reports"
          }
        ]
      }
    },

    "Clusters": {

      "userCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://train-user-service-ebeya2d2bxbzfjgu.southeastasia-01.azurewebsites.net/"
          }
        }
      },

      "bookingCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://train-booking-service-cmgpdkaze6bgd7cu.southeastasia-01.azurewebsites.net/"
          }
        }
      },

      "predictionCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://train-prediction-service-hwechnhwdsg9b9h8.southeastasia-01.azurewebsites.net/"
          }
        }
      },

      "reportCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://train-reporting-service-fkhsgfbucbcggeap.southeastasia-01.azurewebsites.net/"
          }
        }
