{
  "ReverseProxy": {
    "Routes": {
      "userRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/users"
          }
        ]
      },

      "bookingRoute": {
        "ClusterId": "bookingCluster",
        "Match": {
          "Path": "/bookings/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/bookings"
          }
        ]
      },

      "predictionRoute": {
        "ClusterId": "predictionCluster",
        "Match": {
          "Path": "/predictions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/predictions"
          }
        ]
      },
      "reportRoute": {
        "ClusterId": "reportCluster",
        "Match": {
          "Path": "/reports/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/reports"
          }
        ]
      }
    },

    "Clusters": {
      "userCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001/"
          }
        }
      },

      "bookingCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004/"
          }
        }
      },

      "predictionCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "reportCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}