<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Enterprise Train Reservation</title>

    <link rel="stylesheet" asp-href-include="~/lib/bootstrap/dist/css/bootstrap.min.css" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TrainReservation.Client.styles.css"
          asp-append-version="true" />
</head>

<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark shadow"
         style="background:linear-gradient(90deg,#0F4C81,#2563EB);">

        <div class="container">

            <a class="navbar-brand fw-bold text-white"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-train-front-fill me-2"></i>

                Enterprise Train Reservation

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbar"
                    aria-controls="navbar"
                    aria-expanded="false">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbar">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">

                        <a class="nav-link text-white"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house-door-fill me-1"></i>
                            Home

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link text-white"
                           asp-controller="Booking"
                           asp-action="Create">

                            <i class="bi bi-ticket-perforated-fill me-1"></i>
                            New Booking

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link text-white"
                           asp-controller="Booking"
                           asp-action="Index">

                            <i class="bi bi-journal-text me-1"></i>
                            My Bookings

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link text-white"
                           asp-controller="Report"
                           asp-action="Weekly">

                            <i class="bi bi-bar-chart-fill me-1"></i>
                            Weekly Summary

                        </a>

                    </li>

                </ul>

                <ul class="navbar-nav">

                    <li class="nav-item">

                        <a class="nav-link text-warning fw-bold"
                           asp-controller="Account"
                           asp-action="Logout">

                            <i class="bi bi-box-arrow-right me-1"></i>

                            Logout

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <main class="container py-4">

        @RenderBody()

    </main>

    <footer class="bg-white border-top mt-5 shadow-sm">

        <div class="container text-center py-4">

            <h6 class="mb-1">

                <i class="bi bi-train-front-fill text-primary"></i>

                Enterprise Train Reservation System

            </h6>

            <small class="text-muted">

                © 2026 All Rights Reserved

            </small>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>