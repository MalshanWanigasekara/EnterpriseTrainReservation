@model Shared.Requests.LoginRequest

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Enterprise Train Reservation</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                margin: 0;
                height: 100vh;
                background: linear-gradient(135deg,#0F4C81,#2563EB,#3B82F6);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: "Segoe UI",sans-serif;
            }

            .login-card {
                width: 950px;
                min-height: 560px;
                border-radius: 25px;
                overflow: hidden;
                background: white;
                box-shadow: 0 30px 60px rgba(0,0,0,.25);
            }

            .left-panel {
                background: linear-gradient(160deg,#0F4C81,#1E40AF);
                color: white;
                padding: 60px;
                height: 100%;
            }

                .left-panel h1 {
                    font-weight: bold;
                    margin-top: 30px;
                }

                .left-panel p {
                    margin-top: 20px;
                    font-size: 18px;
                    opacity: .9;
                }

            .train-icon {
                font-size: 80px;
            }

            .right-panel {
                padding: 60px;
            }

            .title {
                font-weight: bold;
                color: #0F4C81;
            }

            .subtitle {
                color: gray;
                margin-bottom: 40px;
            }

            .form-control {
                border-radius: 10px;
                height: 50px;
            }

            .btn-login {
                height: 50px;
                border-radius: 10px;
                background: #2563EB;
                border: none;
                font-weight: bold;
            }

                .btn-login:hover {
                    background: #1D4ED8;
                }

            .register-link {
                text-decoration: none;
                font-weight: 600;
            }

            .feature {
                margin-top: 35px;
            }

                .feature i {
                    color: #FFD54F;
                    margin-right: 10px;
                }

    </style>

</head>

<body>

    <div class="login-card">

        <div class="row g-0 h-100">

            <div class="col-lg-5 left-panel">

                <div class="train-icon">

                    <i class="bi bi-train-front-fill"></i>

                </div>

                <h1>

                    Enterprise Train Reservation

                </h1>

                <p>

                    Book train journeys quickly, securely and conveniently.

                </p>

                <div class="feature">

                    <p><i class="bi bi-check-circle-fill"></i>Online Seat Reservation</p>

                    <p><i class="bi bi-check-circle-fill"></i>Smart Booking Prediction</p>

                    <p><i class="bi bi-check-circle-fill"></i>Weekly Booking Reports</p>

                    <p><i class="bi bi-check-circle-fill"></i>Fast & Secure Experience</p>

                </div>

            </div>

            <div class="col-lg-7 right-panel">

                <h2 class="title">

                    Welcome Back

                </h2>

                <p class="subtitle">

                    Sign in to continue

                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">

                        @ViewBag.Error

                    </div>
                }

                <form asp-action="Login"
                      method="post">

                    <div class="mb-4">

                        <label class="form-label">

                            National Identity Card

                        </label>

                        <input asp-for="Nic"
                               class="form-control"
                               placeholder="Enter NIC" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">

                            Password

                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Enter Password" />

                    </div>

                    <button class="btn btn-primary btn-login w-100">

                        <i class="bi bi-box-arrow-in-right"></i>

                        Login

                    </button>

                </form>

                <hr class="my-4" />

                <div class="text-center">

                    Don't have an account?

                    <a asp-action="Register"
                       class="register-link">

                        Register Here

                    </a>

                </div>

            </div>

        </div>

    </div>

</body>

</html>